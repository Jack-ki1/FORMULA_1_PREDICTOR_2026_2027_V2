# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Env secrets — keep example, ignore real
.env
.env.local

# Cache — keep directory structure but ignore contents ( HF ephemeral disk is cheap, but don't bloat build context )
cache/api_responses/*.json
cache/fastf1_cache/*
cache/model_cache/*
*.db
*.sqlite
*.sqlite3

# Git
.git/
.gitignore

# OS
.DS_Store
Thumbs.db
*.log

# Keep for HF Space: do NOT ignore these (needed in image)
# README.md, docs/, and dashboard/static/img|videos are intentionally NOT ignored
# (previous version ignored *.md, docs/, *.mp4, *.png — that broke the Space)

# Tests — keep but don't need in production image if you want smaller image, uncomment:
# tests/
# .pytest_cache/
# .coverage
# htmlcov/
